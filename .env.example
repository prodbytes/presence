# The real values are kept in the private prodbytes/setec-astronomy repo
# (presence.nu01/.env); scripts/link-private.sh links them in. Otherwise,
# copy this to .env (gitignored) and fill it in. Loaded into the Flutter app with
# --dart-define by scripts/flutter-web.sh and scripts/flutter-run.sh; only
# the names listed in scripts/dart-defines.sh reach the app.
# Google OAuth client IDs, from the project's Google Cloud project (named in
# the private repo's README).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Android's own client: Google matches it by package name and signing-key
# SHA-1, so the app doesn't need it (it isn't passed to Flutter).
GOOGLE_ANDROID_CLIENT_ID=
# Cloud sync of signed-in users' clips and events (presence_infra/: the
# presence-identity and presence-user-data stack outputs). Empty turns it off.
AWS_REGION=us-east-1
COGNITO_IDENTITY_POOL_ID=
USER_DATA_BUCKET=
# Live sync (MQTT, AWS IoT Core): the account's data endpoint, from
# `aws iot describe-endpoint --endpoint-type iot:Data-ATS` (what
# scripts/deploy.sh passes to the web build). Android and local builds take
# it from here. Empty turns live sync off; events still sync every 15 s.
IOT_ENDPOINT=
# Production deploys (scripts/deploy.sh): the site's Route 53 zone.
HOSTED_ZONE_ID=
# Deploys: who is emailed when the site's /health check fails or recovers,
# comma-separated. Empty: julio+health@nu01.com.
PRESENCE_HEALTH_EMAILS=
# The web client's secret. Not for the app (it would ship in the web
# bundle); only a backend would use it. Never passed to Flutter.
GOOGLE_WEB_CLIENT_SECRET=

# rbacr (github.com/prodbytes/rbacr), which keeps every role, in its
# "presence" system: free uses the app, premium also syncs with the cloud
# (S3), admin also administers it; rbacr's roots get every role.
# Subscriptions (at nu01.com) and vouchers grant there. Each token: an rbacr API token owned by
# an rbacr root of that rbacr (it asks about anyone and grants). Secrets:
# never commit them.
# GA rbacr, for deploys (scripts/deploy.sh requires the token; prod only
# ever uses https://rbacr.nu01.com). CI takes it from the RBACR_TOKEN
# repository secret.
RBACR_URL=https://rbacr.nu01.com
RBACR_TOKEN=
RBACR_SYSTEM=presence
# rbacr's RC (its own database), for local development: the local Floci
# stack's roles and grants (devbox services up). A token made on
# https://rc.rbacr.nu01.com/me.
RBACR_RC_URL=https://rc.rbacr.nu01.com
RBACR_RC_TOKEN=
RBACR_RC_SYSTEM=presence
