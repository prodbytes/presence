{
  "name": "Presence",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  // Flutter, Floci and the Java Lambdas together need more than the
  // smallest machine.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  // Floci runs in docker-in-docker, where host-gateway is the bridge
  // address, not loopback: the dev servers must listen on every interface
  // for its CloudFront to reach them (only the container sees them).
  "containerEnv": {
    "PRESENCE_BIND_HOST": "0.0.0.0"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",
        "golang.go",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-xml",
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "forwardPorts": [8080, 4566, 8081, 8443],
  "portsAttributes": {
    "8080": { "label": "Flutter web" },
    "4566": { "label": "Floci (CloudFront)" },
    "8081": { "label": "Index (redirect to /app/)" },
    "8443": { "label": "Floci HTTPS" }
  },
  "postCreateCommand": "bash -lc 'bash .devcontainer/post-create.sh'"
}
