# Presence as a camera: a full-screen kiosk on tty1, started at boot and
# restarted whenever it stops. cage (a minimal Wayland compositor) runs one
# app full screen: the Presence web app in Chromium, or the native app (see
# /etc/default/presence). Managed with `sudo presence-kiosk`.
[Unit]
Description=Presence camera kiosk
Documentation=https://github.com/prodbytes/presence/blob/main/specs/raspberry-pi.md
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service
After=systemd-logind.service dbus.socket network-online.target
Wants=systemd-logind.service dbus.socket network-online.target
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty0
# Never give up restarting.
StartLimitIntervalSec=0

[Service]
Type=simple
User=presence
EnvironmentFile=-/etc/default/presence
ExecStart=/opt/presence/lib/kiosk-session
Restart=always
RestartSec=5
# A logind session on seat0 for the presence user, so cage gets the display
# and input devices without root.
PAMName=presence-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

# Hardening, kept compatible with Chromium's sandbox (its renderers run in
# their own user namespace with seccomp; verified under exactly these
# settings): see specs/raspberry-pi.md. Left out on purpose:
# RestrictNamespaces= (Chromium's sandbox needs user namespaces),
# MemoryDenyWriteExecute= (V8's JIT and WebAssembly), PrivateDevices= (the
# camera, GPU and input devices), PrivateUsers= and SystemCallFilter=
# (Chromium installs its own seccomp filters per process).
NoNewPrivileges=yes
ProtectSystem=strict
# The profile (sign-in, events, clips) in the home; /run/user/<uid>, the
# logind session's runtime directory, for cage's Wayland socket.
ReadWritePaths=/var/lib/presence -/run/user
# Not ProtectHome=yes: that also hides /run/user, where cage must put its
# Wayland socket. Other users' homes stay out of reach.
InaccessiblePaths=-/home -/root
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
