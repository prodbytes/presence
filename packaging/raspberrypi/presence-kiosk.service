# Presence as a camera: a full-screen kiosk on tty1, started at boot and
# restarted whenever it stops. cage (a minimal Wayland compositor) runs one
# app full screen: the Presence web app in Chromium, or the native app (see
# /etc/default/presence). Managed with `sudo presence-kiosk`.
[Unit]
Description=Presence camera kiosk
Documentation=https://github.com/prodbytes/presence/blob/main/specs/raspberry-pi.md
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service
After=systemd-logind.service dbus.socket network-online.target
Wants=systemd-logind.service dbus.socket network-online.target
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty0
# Never give up restarting.
StartLimitIntervalSec=0

[Service]
Type=simple
User=presence
EnvironmentFile=-/etc/default/presence
ExecStart=/opt/presence/lib/kiosk-session
Restart=always
RestartSec=5
# A logind session on seat0 for the presence user, so cage gets the display
# and input devices without root.
PAMName=presence-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ProtectHome=yes

[Install]
WantedBy=multi-user.target
